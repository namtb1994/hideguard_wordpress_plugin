{
    "name": "hachitechs/hideguard-wordpress",
    "description": "HideGuard page and WooCommerce protection using hachitechs/hideguard-php",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-mysqli": "*",
        "ext-sodium": "*",
        "hachitechs/hideguard-php": "^1.0",
        "psr/log": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "repositories": [{
        "type": "vcs",
        "url": "https://github.com/namtb1994/hachitechs-hideguard-php.git",
        "only": ["hachitechs/hideguard-php"]
    }],
    "autoload": {"psr-4": {"Hachitechs\\HideguardWordPress\\": "src/"}},
    "config": {
        "sort-packages": true,
        "platform": {"php": "8.1.0"},
        "preferred-install": {"hachitechs/hideguard-php": "source", "*": "dist"}
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=PSR12 src views bin hachitechs-hideguard.php",
        "assets": "php bin/publish-assets.php",
        "assets-check": "php bin/publish-assets.php --check"
    }
}
