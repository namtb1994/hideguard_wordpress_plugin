"html.hachitech-ab-locked body,\nbody[data-hachitech-ab-inert] {\n  overflow: hidden;\n}\n.hachitech-ab-gate {\n  align-items: center;\n  background: transparent;\n  box-sizing: border-box;\n  color: #182830;\n  display: flex;\n  flex-direction: column;\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n  inset: 0;\n  justify-content: center;\n  line-height: 1.6;\n  overflow: auto;\n  padding: 24px;\n  pointer-events: auto;\n  position: fixed;\n  text-align: center;\n  visibility: visible !important;\n  z-index: 2147483647;\n}\n.hachitech-ab-gate[hidden] {\n  display: none;\n}\n.hachitech-ab-gate[data-state='blocked'],\n.hachitech-ab-gate[data-page='gate'] {\n  background: #fff;\n}\n.hachitech-ab-gate .hachitech-ab-message {\n  background: #fff;\n  border: 1px solid #e5eaed;\n  border-radius: 24px;\n  box-shadow: 0 20px 64px rgba(24, 40, 48, 0.08);\n  box-sizing: border-box;\n  flex-shrink: 0;\n  margin: auto 0;\n  max-width: 560px;\n  padding: 48px;\n  width: 100%;\n}\n.hachitech-ab-gate .hachitech-ab-icon {\n  align-items: center;\n  background: #fff1e8;\n  border-radius: 20px;\n  color: #aa562e;\n  display: flex;\n  height: 72px;\n  justify-content: center;\n  margin: 0 auto 24px;\n  width: 72px;\n}\n.hachitech-ab-gate .hachitech-ab-eyebrow {\n  color: #63727a;\n  display: block;\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.14em;\n  margin-bottom: 12px;\n  text-transform: uppercase;\n}\n.hachitech-ab-gate h2 {\n  color: #182830;\n  font-size: 30px;\n  font-weight: 600;\n  letter-spacing: -0.025em;\n  line-height: 1.25;\n  margin: 0 0 16px;\n}\n.hachitech-ab-gate p {\n  color: #63727a;\n  font-size: 16px;\n  line-height: 1.7;\n  margin: 0;\n}\n.hachitech-ab-gate .hachitech-ab-guidance {\n  background: #f6f8fa;\n  border-radius: 12px;\n  color: #63727a;\n  display: none;\n  font-size: 13px;\n  line-height: 1.7;\n  margin-top: 28px;\n  padding: 20px 24px;\n}\n.hachitech-ab-gate .hachitech-ab-guidance-title {\n  color: #182830;\n  display: block;\n  font-size: 12px;\n  font-weight: 600;\n  margin-bottom: 4px;\n}\n.hachitech-ab-gate[data-state='blocked'] .hachitech-ab-guidance {\n  display: block;\n}\n.hachitech-ab-gate .hachitech-ab-retry {\n  display: none;\n  margin-top: 24px;\n}\n.hachitech-ab-gate[data-state='error'] .hachitech-ab-retry {\n  display: inline-block;\n}\n.hachitech-ab-gate[data-state='pending']:not([data-page='gate']) .hachitech-ab-message {\n  border: 0;\n  box-shadow: none;\n  clip: rect(0, 0, 0, 0);\n  clip-path: inset(50%);\n  height: 1px;\n  margin: -1px;\n  overflow: hidden;\n  padding: 0;\n  position: absolute;\n  white-space: nowrap;\n  width: 1px;\n}\n.hachitech-ab-gate noscript {\n  color: #63727a;\n  font-size: 13px;\n  margin-top: 20px;\n  max-width: 440px;\n}\n@media (max-width: 480px) {\n  .hachitech-ab-gate {\n    padding: 20px;\n  }\n  .hachitech-ab-gate .hachitech-ab-message {\n    border-radius: 20px;\n    padding: 32px 24px;\n  }\n  .hachitech-ab-gate .hachitech-ab-guidance {\n    padding: 16px;\n  }\n  .hachitech-ab-gate h2 {\n    font-size: 26px;\n  }\n}\n"
